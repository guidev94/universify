# LetsWork Analytics Plugin — Environment Variables
# Add these to your Mautic server environment or .env file

# Gemini AI API Key (required for IA features: insights, classification, summaries)
GEMINI_API_KEY=REMOVED_KEY

# Webhook authentication token (optional — for external integrations like Roboze)
ANALYTICS_WEBHOOK_TOKEN=your_secret_token_here

# Email sender (optional — falls back to Mautic admin email)
MAUTIC_ADMIN_EMAIL=admin@yourdomain.com
