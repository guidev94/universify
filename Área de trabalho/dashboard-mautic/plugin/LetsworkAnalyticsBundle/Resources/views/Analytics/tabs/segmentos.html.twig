{# KPIs Segmento #}
<div class="lwa-section-label">Visão por Segmento (ICP)</div>

{# Tabela de Performance #}
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-header"><h4>Performance por Segmento — ICP Prioritários</h4></div>
    <div class="lwa-card-body lwa-card-body--tight">
        {% if performance is empty %}
            <div class="lwa-empty-state"><p>Sem dados no período.</p></div>
        {% else %}
            <table class="lwa-table">
                <thead><tr><th>Segmento</th><th>Total</th><th>Quentes</th><th>Ganhos</th><th>Perdidos</th><th>Taxa</th></tr></thead>
                <tbody>
                    {% for r in performance %}
                        {% set perdidos = r.total - r.quentes|default(0) - r.ganhos|default(0) %}
                        <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowSegmentoLeads('{{ r.segmento|e('js') }}')">
                            <td><strong>{{ r.segmento }}</strong></td>
                            <td>{{ r.total }}</td>
                            <td>{{ r.quentes|default(0) }}</td>
                            <td><span style="color:#10b981;font-weight:600">{{ r.ganhos|default(0) }}</span></td>
                            <td><span style="color:#dc2626;font-weight:600">{{ perdidos > 0 ? perdidos : 0 }}</span></td>
                            <td><strong>{{ r.total > 0 ? ((r.ganhos / r.total * 100)|round(1)) : 0 }}%</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

{# Ranking Visual #}
{% if ranking.labels is not empty %}
<div class="lwa-section-label">Ranking de Conversão (%)</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ ranking|json_encode }}" style="height:220px;width:100%;"></canvas>
    </div>
</div>
{% endif %}

{# Segmentos Nativos do Mautic (Dinâmico) #}
{% if mautic_segments is defined and mautic_segments is not empty %}
<div class="lwa-section-label">Segmentos Mautic (Automáticos)</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body lwa-card-body--tight">
        <table class="lwa-table lwa-table--compact">
            <thead><tr><th>Segmento</th><th>Leads Ativos</th></tr></thead>
            <tbody>
                {% for s in mautic_segments %}
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('segmento_nativo_{{ s.id }}', '{{ s.name|e('js') }}')">
                        <td><strong>{{ s.name }}</strong> <span class="lwa-tag" style="margin-left:4px">{{ s.alias }}</span></td>
                        <td><strong>{{ s.total_leads }}</strong></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{# Segmentos ICP (Campo customizado — dinâmico do banco) #}
{% if performance is not empty %}
<div class="lwa-section-label">ICP por Segmento</div>
<div class="lwa-card">
    <div class="lwa-card-body">
        <div style="display:flex;flex-wrap:wrap;gap:8px">
            {% for r in performance %}
                <span class="lwa-tag" style="padding:6px 12px;font-size:13px;cursor:pointer" onclick="Mautic.lwaShowSegmentoLeads('{{ r.segmento|e('js') }}')">{{ r.segmento }} ({{ r.total }})</span>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

{# ===== IA ===== #}
<div class="lwa-section-label"><span><i class="ri-sparkling-line"></i> Análise IA — Segmentos</span><button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaAiTab('segmentos')" style="font-size:11px;padding:4px 10px">Analisar</button></div>
<div id="lwa-ai-tab-result" style="display:none;margin-bottom:24px"></div>
