{# Ranking de Conversão por Segmento #}
<div class="lwa-section-label">Ranking de Conversão</div>
<div class="lwa-charts-row">
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Taxa de Conversão por Segmento (%)',
        type: 'bar',
        data: ranking,
        wide: true,
        height: 320
    } %}
</div>

{# Tabela de Performance #}
<div class="lwa-section-label">Performance por Segmento</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body">
        {% if performance is empty %}
            <div class="lwa-empty-state"><i class="ri-pie-chart-line"></i><p>Sem dados de segmento no período</p></div>
        {% else %}
            <table class="lwa-table">
                <thead>
                    <tr>
                        <th>Segmento</th>
                        <th>Total de Leads</th>
                        <th>Leads Quentes</th>
                        <th>Clientes Ganhos</th>
                        <th>Taxa de Conversão</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in performance %}
                        <tr>
                            <td><strong>{{ r.segmento }}</strong></td>
                            <td>{{ r.total }}</td>
                            <td>{{ r.quentes|default(0) }}</td>
                            <td>{{ r.ganhos|default(0) }}</td>
                            <td><strong>{{ r.total > 0 ? ((r.ganhos / r.total * 100)|round(1)) : 0 }}%</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
