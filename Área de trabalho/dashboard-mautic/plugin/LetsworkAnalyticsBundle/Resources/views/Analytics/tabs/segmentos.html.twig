{# Taxa de Conversão por Segmento (PRD Seção 18) #}
<div class="lwa-section-label">Taxa de Conversão por Segmento</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ ranking|json_encode }}" style="height:280px;width:100%;"></canvas>
    </div>
</div>

{# Performance Detalhada (PRD Seção 6 — ICP) #}
<div class="lwa-section-label">Performance por Segmento</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body lwa-card-body--tight">
        {% if performance is empty %}
            <div class="lwa-empty-state"><p>Sem dados no período.</p></div>
        {% else %}
            <table class="lwa-table">
                <thead><tr><th>Segmento</th><th>Total</th><th>Quentes</th><th>Ganhos</th><th>Taxa</th></tr></thead>
                <tbody>
                    {% for r in performance %}
                        <tr>
                            <td><strong>{{ r.segmento }}</strong></td>
                            <td>{{ r.total }}</td>
                            <td>{{ r.quentes|default(0) }}</td>
                            <td>{{ r.ganhos|default(0) }}</td>
                            <td><strong>{{ r.total > 0 ? ((r.ganhos / r.total * 100)|round(1)) : 0 }}%</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
