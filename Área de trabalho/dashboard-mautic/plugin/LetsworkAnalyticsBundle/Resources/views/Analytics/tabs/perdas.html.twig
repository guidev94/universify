{# Loss KPIs #}
<div class="lwa-section-label">Análise de Perdas</div>
<div class="lwa-charts-row">
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Motivos de Perda (Top 8)',
        type: 'doughnut',
        data: reasons,
        height: 300
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Tendência de Perdas no Período',
        type: 'line',
        data: trend,
        wide: true,
        height: 300
    } %}
</div>

{# Loss Tables #}
<div class="lwa-section-label">Detalhamento</div>
<div class="lwa-charts-row" style="margin-bottom: 0;">
    <div class="lwa-table-section lwa-card" style="flex:1;">
        <div class="lwa-card-header"><h4>Perdas por Origem</h4></div>
        <div class="lwa-card-body">
            {% if by_origin is empty %}
                <div class="lwa-empty-state"><p>Sem dados</p></div>
            {% else %}
                <table class="lwa-table">
                    <thead><tr><th>Origem</th><th>Perdas</th></tr></thead>
                    <tbody>
                        {% for r in by_origin %}
                            <tr>
                                <td><span class="lwa-tag">{{ r.origem_principal|replace({'_': ' '}) }}</span></td>
                                <td><strong>{{ r.total }}</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    <div class="lwa-table-section lwa-card" style="flex:1;">
        <div class="lwa-card-header"><h4>Perdas por Segmento</h4></div>
        <div class="lwa-card-body">
            {% if by_segment is empty %}
                <div class="lwa-empty-state"><p>Sem dados</p></div>
            {% else %}
                <table class="lwa-table">
                    <thead><tr><th>Segmento</th><th>Perdas</th></tr></thead>
                    <tbody>
                        {% for r in by_segment %}
                            <tr>
                                <td>{{ r.segmento }}</td>
                                <td><strong>{{ r.total }}</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
