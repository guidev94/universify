{# KPIs de Perda #}
<div class="lwa-section-label">Resumo de Perdas</div>
{% set total_perdas = by_origin|reduce((carry, r) => carry + r.total, 0) %}
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Leads Perdidos', value: total_perdas, icon: 'ri-close-circle-line', color: 'error',
        description: 'No período selecionado'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Motivos Registrados', value: reasons.labels|length|default(0), icon: 'ri-list-check',
        description: 'Razões identificadas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Origens Afetadas', value: by_origin|length|default(0), icon: 'ri-global-line',
        description: 'Canais com perdas'
    } %}
</div>

{# Motivos — Gráfico + Lista lado a lado #}
<div class="lwa-section-label">Motivos de Perda</div>
<div class="lwa-grid-2">
    <div class="lwa-card">
        <div class="lwa-card-body">
            <canvas class="lwa-chart" data-chart-type="doughnut" data-chart-data="{{ reasons|json_encode }}" style="height:240px;width:100%;"></canvas>
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-body lwa-card-body--tight">
            {% if reasons.labels is empty %}
                <div class="lwa-empty-state"><p>Sem motivos registrados.</p></div>
            {% else %}
                <table class="lwa-table">
                    <thead><tr><th>Motivo</th><th>Leads</th></tr></thead>
                    <tbody>
                        {% for i in 0..reasons.labels|length - 1 %}
                            <tr><td>{{ reasons.labels[i] }}</td><td><strong>{{ reasons.data[i] }}</strong></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>

{# Tendência #}
{% if trend.labels is not empty %}
<div class="lwa-section-label">Tendência de Perdas</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="line" data-chart-data="{{ trend|json_encode }}" style="height:180px;width:100%;"></canvas>
    </div>
</div>
{% endif %}

{# Detalhamento por Origem e Segmento #}
<div class="lwa-section-label">Detalhamento</div>
<div class="lwa-grid-2">
    {% set origin_labels = {'linkedin_roboze':'LinkedIn / Roboze','letswork_site':"Let's Work Site",'apollo':'Apollo','lista_importada':'Lista Importada','indicação':'Indicação'} %}
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Por Origem</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_origin is empty %}
                <div class="lwa-empty-state"><p>Sem dados.</p></div>
            {% else %}
                <table class="lwa-table lwa-table--compact">
                    <tbody>
                        {% for r in by_origin %}
                            <tr><td>{{ origin_labels[r.origem_principal]|default(r.origem_principal|replace({'_':' '})|title) }}</td><td><strong>{{ r.total }}</strong></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Por Segmento</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_segment is empty %}
                <div class="lwa-empty-state"><p>Sem dados.</p></div>
            {% else %}
                <table class="lwa-table lwa-table--compact">
                    <tbody>
                        {% for r in by_segment %}<tr><td>{{ r.segmento }}</td><td><strong>{{ r.total }}</strong></td></tr>{% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
