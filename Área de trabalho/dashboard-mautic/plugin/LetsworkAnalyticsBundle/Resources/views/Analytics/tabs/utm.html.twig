{# ===== UTM TRACKING ===== #}

{# Pipeline UTM — Cards de Temperatura #}
<div class="lwa-section-label">Pipeline UTM — Leads por Etapa</div>
<div class="lwa-kpi-row lwa-kpi-row--full">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Prospecção', value: utm_pipeline.prospeccao|default(0), icon: 'ri-user-search-line', color: 'info',
        kpi_id: 'utm_leads', description: 'Sem interação'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Frio', value: utm_pipeline.frio|default(0), icon: 'ri-temp-cold-line', color: 'info',
        kpi_id: 'utm_leads', description: 'Score 0–20'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Morno', value: utm_pipeline.morno|default(0), icon: 'ri-temp-hot-line', color: 'warning',
        kpi_id: 'utm_leads', description: 'Score 21–60'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Quente', value: utm_pipeline.quente|default(0), icon: 'ri-fire-line', color: 'error',
        kpi_id: 'utm_leads', description: 'Score 61–100'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Prioritário', value: utm_pipeline.prioritario|default(0), icon: 'ri-vip-crown-line', color: 'purple',
        kpi_id: 'utm_leads', description: 'Score 100+'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Reuniões', value: utm_pipeline.reunioes|default(0), icon: 'ri-calendar-check-line', color: 'primary',
        kpi_id: 'utm_leads', description: 'Agendadas + realizadas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Propostas', value: utm_pipeline.propostas|default(0), icon: 'ri-file-text-line', color: 'purple',
        kpi_id: 'utm_leads', description: 'Em negociação'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Ganhos', value: utm_pipeline.ganhos|default(0), icon: 'ri-trophy-line', color: 'success',
        kpi_id: 'utm_leads', description: 'Convertidos via UTM'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Perdidos', value: utm_pipeline.perdidos|default(0), icon: 'ri-close-circle-line', color: 'error',
        kpi_id: 'utm_leads', description: 'Não converteram'
    } %}
</div>

{# Resumo #}
<div class="lwa-section-label">Resumo de Canais</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Total Leads UTM', value: total, icon: 'ri-link', color: 'primary',
        kpi_id: 'utm_leads', description: 'Leads rastreados'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Sources', value: by_source|length, icon: 'ri-global-line', color: 'info',
        kpi_id: 'utm_sources', description: 'Origens distintas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Campanhas UTM', value: by_campaign|length, icon: 'ri-megaphone-line', color: 'purple',
        kpi_id: 'utm_campaigns', description: 'Campanhas UTM ativas'
    } %}
</div>

{# Pipeline Temperatura por Source #}
{% if pipeline is defined and pipeline is not empty %}
<div class="lwa-section-label">Pipeline por Temperatura (UTM Source → Conversão)</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body lwa-card-body--tight">
        <table class="lwa-table">
            <thead><tr><th>Source</th><th><span class="lwa-badge lwa-badge--frio">Frio</span></th><th><span class="lwa-badge lwa-badge--morno">Morno</span></th><th><span class="lwa-badge lwa-badge--quente">Quente</span></th><th><span class="lwa-badge lwa-badge--prioritario">Prioritário</span></th><th style="color:#dc2626">Perdidos</th></tr></thead>
            <tbody>
                {% for r in by_source %}
                    <tr>
                        <td><strong>{{ r.utm_source }}</strong></td>
                        {% set frio = 0 %}{% set morno = 0 %}{% set quente = 0 %}{% set prio = 0 %}{% set perdidos = 0 %}
                        {% for p in pipeline %}
                            {% if p.utm_source == r.utm_source %}
                                {% set ptk = p.temperatura|lower|replace({'á':'a','é':'e','í':'i','ó':'o','ú':'u','ã':'a'}) %}
                                {% if ptk == 'frio' %}{% set frio = p.leads %}{% endif %}
                                {% if ptk == 'morno' %}{% set morno = p.leads %}{% endif %}
                                {% if ptk == 'quente' %}{% set quente = p.leads %}{% endif %}
                                {% if ptk == 'prioritario' %}{% set prio = p.leads %}{% endif %}{% set perdidos = perdidos + (p.perdidos|default(0)) %}
                            {% endif %}
                        {% endfor %}
                        <td>{{ frio }}</td>
                        <td>{{ morno }}</td>
                        <td>{{ quente }}</td>
                        <td>{{ prio }}</td>
                        <td style="color:#dc2626">{{ perdidos|default(0) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{# Pipeline Temperatura por Campaign #}
{% if campaign_pipeline is defined and campaign_pipeline is not empty %}
<div class="lwa-section-label">Campanhas → Conversão por Temperatura</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body lwa-card-body--tight">
        <table class="lwa-table">
            <thead><tr><th>Campaign</th><th><span class="lwa-badge lwa-badge--frio">Frio</span></th><th><span class="lwa-badge lwa-badge--morno">Morno</span></th><th><span class="lwa-badge lwa-badge--quente">Quente</span></th><th><span class="lwa-badge lwa-badge--prioritario">Prioritário</span></th><th style="color:#dc2626">Perdidos</th></tr></thead>
            <tbody>
                {% for r in by_campaign %}
                    <tr>
                        <td><strong>{{ r.utm_campaign }}</strong></td>
                        {% set frio = 0 %}{% set morno = 0 %}{% set quente = 0 %}{% set prio = 0 %}{% set perdidos = 0 %}
                        {% for p in campaign_pipeline %}
                            {% if p.utm_campaign == r.utm_campaign %}
                                {% set ptk = p.temperatura|lower|replace({'á':'a','é':'e','í':'i','ó':'o','ú':'u','ã':'a'}) %}
                                {% if ptk == 'frio' %}{% set frio = p.leads %}{% endif %}
                                {% if ptk == 'morno' %}{% set morno = p.leads %}{% endif %}
                                {% if ptk == 'quente' %}{% set quente = p.leads %}{% endif %}
                                {% if ptk == 'prioritario' %}{% set prio = p.leads %}{% endif %}{% set perdidos = perdidos + (p.perdidos|default(0)) %}
                            {% endif %}
                        {% endfor %}
                        <td>{{ frio }}</td>
                        <td>{{ morno }}</td>
                        <td>{{ quente }}</td>
                        <td>{{ prio }}</td>
                        <td style="color:#dc2626">{{ perdidos|default(0) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{# UTM Source #}
<div class="lwa-section-label">UTM Source (Origem do tráfego)</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body lwa-card-body--tight">
        {% if by_source is empty %}
            <div class="lwa-empty-state"><p>Nenhum UTM Source registrado no período.</p></div>
        {% else %}
            <table class="lwa-table">
                <thead><tr><th>Source</th><th>Leads</th><th>Hits</th></tr></thead>
                <tbody>
                    {% for r in by_source %}
                        <tr><td><strong>{{ r.utm_source }}</strong></td><td>{{ r.leads }}</td><td>{{ r.hits }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

{# UTM Medium + Campaign lado a lado #}
<div class="lwa-grid-2">
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>UTM Medium</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_medium is empty %}
                <div class="lwa-empty-state"><p>Sem dados.</p></div>
            {% else %}
                <table class="lwa-table lwa-table--compact">
                    <thead><tr><th>Medium</th><th>Leads</th></tr></thead>
                    <tbody>
                        {% for r in by_medium %}
                            <tr><td><strong>{{ r.utm_medium }}</strong></td><td>{{ r.leads }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>UTM Campaign</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_campaign is empty %}
                <div class="lwa-empty-state"><p>Sem dados.</p></div>
            {% else %}
                <table class="lwa-table lwa-table--compact">
                    <thead><tr><th>Campaign</th><th>Leads</th><th>Hits</th></tr></thead>
                    <tbody>
                        {% for r in by_campaign %}
                            <tr><td><strong>{{ r.utm_campaign }}</strong></td><td>{{ r.leads }}</td><td>{{ r.hits }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>

{# UTM Content + Term #}
<div class="lwa-grid-2" style="margin-top:24px">
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>UTM Content</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_content is empty %}
                <div class="lwa-empty-state"><p>Sem dados.</p></div>
            {% else %}
                <table class="lwa-table lwa-table--compact">
                    <tbody>
                        {% for r in by_content %}
                            <tr><td><strong>{{ r.utm_content }}</strong></td><td>{{ r.leads }} leads</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>UTM Term (Keywords)</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_term is empty %}
                <div class="lwa-empty-state"><p>Sem dados.</p></div>
            {% else %}
                <table class="lwa-table lwa-table--compact">
                    <tbody>
                        {% for r in by_term %}
                            <tr><td><strong>{{ r.utm_term }}</strong></td><td>{{ r.leads }} leads</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>

{# Leads recentes com UTM #}
{% if recent is not empty %}
<div class="lwa-section-label" style="margin-top:24px">Leads Recentes com UTM</div>
<div class="lwa-card">
    <div class="lwa-card-body lwa-card-body--tight">
        <table class="lwa-table lwa-table--compact">
            <thead><tr><th>Lead</th><th>Empresa</th><th>Source</th><th>Medium</th><th>Campaign</th><th>Data</th></tr></thead>
            <tbody>
                {% for r in recent %}
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaOpenLeadModal({{ r.lead_id }})">
                        <td><strong>{{ r.firstname }} {{ r.lastname }}</strong></td>
                        <td>{{ r.company|default('-') }}</td>
                        <td>{{ r.utm_source|default('-') }}</td>
                        <td>{{ r.utm_medium|default('-') }}</td>
                        <td>{{ r.utm_campaign|default('-') }}</td>
                        <td>{{ r.date_added|date('d/m/Y') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{# ===== IA ===== #}
<div class="lwa-section-label" style="margin-top:24px"><span><i class="ri-sparkling-line"></i> Análise IA — Performance UTM</span><button class="lwa-btn lwa-btn--ai" onclick="Mautic.lwaAiTab('utm')" style="font-size:11px;padding:4px 10px"><i class="ri-sparkling-line"></i> Analisar Campanhas</button></div>
<div id="lwa-ai-tab-result" style="display:none;margin-bottom:24px"></div>
