{# ============ PIPELINE COMERCIAL ============ #}
<div class="lwa-section-label">Pipeline Comercial</div>
<div class="lwa-kpi-row">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Prospecção',
        value: kpis.prospeccao,
        icon: 'ri-user-search-line',
        color: 'info',
        kpi_id: 'prospeccao',
        description: 'Leads em fase inicial de contato'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Engajados',
        value: kpis.engajados,
        icon: 'ri-chat-check-line',
        color: 'warning',
        kpi_id: 'engajados',
        description: 'Responderam ou demonstraram interesse'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Reuniões',
        value: kpis.reunioes,
        icon: 'ri-calendar-check-line',
        color: 'primary',
        kpi_id: 'reunioes',
        description: 'Agendadas ou realizadas no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Propostas',
        value: kpis.propostas,
        icon: 'ri-file-text-line',
        color: 'purple',
        kpi_id: 'propostas',
        description: 'Propostas enviadas ou em negociação'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Clientes Ganhos',
        value: kpis.ganhos,
        icon: 'ri-trophy-line',
        color: 'success',
        kpi_id: 'ganhos',
        description: 'Convertidos no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Sem Follow-up',
        value: kpis.hot_no_followup,
        icon: 'ri-alarm-warning-line',
        color: 'error',
        kpi_id: 'hot_no_followup',
        description: 'Leads quentes aguardando ação comercial'
    } %}
</div>

{# ============ E-MAIL MARKETING ============ #}
<div class="lwa-section-label">E-mail Marketing</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Campanhas Enviadas',
        value: kpis.emails_enviados,
        icon: 'ri-mail-send-line',
        color: 'primary',
        kpi_id: 'emails_enviados',
        description: 'Total de disparos no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'E-mails Abertos',
        value: kpis.emails_abertos,
        icon: 'ri-mail-open-line',
        color: 'success',
        kpi_id: 'emails_abertos',
        description: 'Leads que abriram os e-mails'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Taxa de Abertura',
        value: kpis.taxa_abertura,
        icon: 'ri-percent-line',
        color: 'warning',
        suffix: '%',
        kpi_id: 'emails_taxa',
        description: 'Performance geral de engajamento'
    } %}
</div>

{# ============ GRÁFICOS ============ #}
<div class="lwa-section-label">Indicadores Visuais</div>
<div class="lwa-charts-row">
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Distribuição por Temperatura',
        type: 'doughnut',
        data: charts.temperature,
        height: 300
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Entrada de Leads no Período',
        type: 'line',
        data: charts.leads_time,
        wide: true,
        height: 300
    } %}
</div>

{# ============ LEADS QUENTES ============ #}
<div class="lwa-section-label">
    <span><i class="ri-fire-line"></i> Leads Quentes — Ação Necessária</span>
    <span class="lwa-section-badge">{{ kpis.hot_no_followup }} pendentes</span>
</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body">
        {% if tables.hot_leads is empty %}
            <div class="lwa-empty-state">
                <i class="ri-checkbox-circle-line"></i>
                <p>Todos os leads quentes estão com follow-up em dia.</p>
            </div>
        {% else %}
            <table class="lwa-table">
                <thead>
                    <tr>
                        <th>Lead</th>
                        <th>Cargo</th>
                        <th>Temperatura</th>
                        <th>Score</th>
                        <th>Última Interação</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in tables.hot_leads %}
                        <tr class="lwa-table-row-interactive" onclick="Mautic.lwaOpenLeadModal({{ row[6] }})">
                            <td>
                                <div class="lwa-lead-cell">
                                    <div class="lwa-lead-avatar lwa-lead-avatar--{% if 'prioritario' in row[2] %}prioritario{% else %}quente{% endif %}">{{ row[0]|first|upper }}</div>
                                    <span class="lwa-lead-name">{{ row[0] }}</span>
                                </div>
                            </td>
                            <td>{{ row[1] }}</td>
                            <td>{{ row[2]|raw }}</td>
                            <td><span class="lwa-score-pill">{{ row[3] }}</span></td>
                            <td>{{ row[4] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

{# ============ MODAIS ============ #}

{# Modal KPI Detail #}
<div id="lwa-kpi-detail" class="lwa-modal" style="display:none;">
    <div class="lwa-modal-overlay" onclick="Mautic.lwaCloseKpiDetail()"></div>
    <div class="lwa-modal-content lwa-modal-content--wide">
        <div class="lwa-modal-header">
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseKpiDetail()" title="Voltar"><i class="ri-arrow-left-line"></i></button>
            <h3 id="lwa-kpi-detail-title"></h3>
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseKpiDetail()"><i class="ri-close-line"></i></button>
        </div>
        <div id="lwa-kpi-detail-body" class="lwa-modal-body"></div>
        <div id="lwa-kpi-pagination" class="lwa-pagination"></div>
    </div>
</div>

{# Modal Lead #}
<div id="lwa-lead-modal" class="lwa-modal" style="display:none;">
    <div class="lwa-modal-overlay" onclick="Mautic.lwaCloseModal()"></div>
    <div class="lwa-modal-content">
        <div class="lwa-modal-header">
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseModal()" title="Voltar"><i class="ri-arrow-left-line"></i></button>
            <h3 id="lwa-modal-title">Detalhes do Lead</h3>
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseModal()"><i class="ri-close-line"></i></button>
        </div>
        <div id="lwa-modal-body" class="lwa-modal-body"></div>
    </div>
</div>
