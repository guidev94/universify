{# ===== MÉTRICAS DE SUCESSO (PRD Seção 18) ===== #}
<div class="lwa-section-label">Métricas de Sucesso</div>
<div class="lwa-kpi-row">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Leads Centralizados', value: kpis.total_leads,
        icon: 'ri-team-line', color: 'info', kpi_id: 'prospeccao', description: 'Novos leads no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Frios → Mornos', value: kpis.frio_to_morno,
        icon: 'ri-temp-hot-line', color: 'warning', kpi_id: 'engajados', description: 'Leads que engajaram'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Mornos → Reunião', value: kpis.morno_to_reuniao,
        icon: 'ri-calendar-check-line', color: 'primary', kpi_id: 'reunioes', description: 'Convertidos em reunião'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Reuniões LinkedIn', value: kpis.reunioes_linkedin,
        icon: 'ri-linkedin-box-line', color: 'info', description: 'Geradas via LinkedIn/Roboze'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Clientes Ganhos', value: kpis.ganhos,
        icon: 'ri-trophy-line', color: 'success', kpi_id: 'ganhos', description: 'Convertidos no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Sem Follow-up', value: kpis.hot_no_followup,
        icon: 'ri-alarm-warning-line', color: 'error', kpi_id: 'hot_no_followup', description: 'Quentes aguardando ação'
    } %}
</div>

{# ===== TEMPERATURA + SCORE (PRD Seção 11) ===== #}
<div class="lwa-section-label">Temperatura dos Leads (Score de Interesse)</div>
<div class="lwa-grid-2">
    {# Tabela com contagem por temperatura #}
    <div class="lwa-card">
        <div class="lwa-card-body">
            <table class="lwa-table lwa-table--temp">
                <thead><tr><th>Score</th><th>Temperatura</th><th>Leads Ativos</th><th>Ação</th></tr></thead>
                <tbody>
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('temp_frio', 'Leads Frios (Score 0-20)')">
                        <td>0 – 20</td>
                        <td><span class="lwa-badge lwa-badge--frio">Frio</span></td>
                        <td><strong>{{ temperatura_counts.frio }}</strong></td>
                        <td>Nutrição leve</td>
                    </tr>
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('temp_morno', 'Leads Mornos (Score 21-60)')">
                        <td>21 – 60</td>
                        <td><span class="lwa-badge lwa-badge--morno">Morno</span></td>
                        <td><strong>{{ temperatura_counts.morno }}</strong></td>
                        <td>Conteúdo + abordagem consultiva</td>
                    </tr>
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('temp_quente', 'Leads Quentes (Score 61-100)')">
                        <td>61 – 100</td>
                        <td><span class="lwa-badge lwa-badge--quente">Quente</span></td>
                        <td><strong>{{ temperatura_counts.quente }}</strong></td>
                        <td>Comercial deve agir</td>
                    </tr>
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('temp_prioritario', 'Leads Prioritários (Score 100+)')">
                        <td>100+</td>
                        <td><span class="lwa-badge lwa-badge--prioritario">Prioritário</span></td>
                        <td><strong>{{ temperatura_counts.prioritario }}</strong></td>
                        <td>Follow-up imediato</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    {# Gráfico de distribuição #}
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Distribuição Visual</h4></div>
        <div class="lwa-card-body">
            <canvas class="lwa-chart" data-chart-type="doughnut" data-chart-data="{{ charts.temperature|json_encode }}" style="height:240px;width:100%;"></canvas>
        </div>
    </div>
</div>

{# ===== E-MAIL MARKETING ===== #}
<div class="lwa-section-label">E-mail Marketing</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Enviados', value: kpis.emails_enviados, icon: 'ri-mail-send-line',
        kpi_id: 'emails_enviados', description: 'Campanhas disparadas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Abertos', value: kpis.emails_abertos, icon: 'ri-mail-open-line',
        kpi_id: 'emails_abertos', description: 'Leads que abriram'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Taxa de Abertura', value: kpis.taxa_abertura, icon: 'ri-percent-line',
        suffix: '%', kpi_id: 'emails_enviados', description: 'Desempenho das campanhas'
    } %}
</div>

{# ===== EVOLUÇÃO ===== #}
<div class="lwa-section-label">Entrada de Leads</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="line" data-chart-data="{{ charts.leads_time|json_encode }}" style="height:200px;width:100%;"></canvas>
    </div>
</div>

{# ===== LEADS QUENTES ===== #}
<div class="lwa-section-label">
    <span>Leads Quentes — Ação Necessária</span>
    {% if kpis.hot_no_followup > 0 %}<span class="lwa-section-badge">{{ kpis.hot_no_followup }}</span>{% endif %}
</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body lwa-card-body--tight">
        {% if tables.hot_leads is empty %}
            <div class="lwa-empty-state"><i class="ri-checkbox-circle-line"></i><p>Nenhum lead quente sem follow-up.</p></div>
        {% else %}
            <table class="lwa-table">
                <thead><tr><th>Lead</th><th>Cargo</th><th>Temperatura</th><th>Score</th><th>Última Interação</th></tr></thead>
                <tbody>
                    {% for row in tables.hot_leads %}
                        <tr class="lwa-table-row-interactive" onclick="Mautic.lwaOpenLeadModal({{ row[6] }})">
                            <td><div class="lwa-lead-cell"><div class="lwa-lead-avatar lwa-lead-avatar--{% if 'prioritario' in row[2] %}prioritario{% else %}quente{% endif %}">{{ row[0]|first|upper }}</div><span class="lwa-lead-name">{{ row[0] }}</span></div></td>
                            <td>{{ row[1] }}</td>
                            <td>{{ row[2]|raw }}</td>
                            <td><span class="lwa-score-pill">{{ row[3] }}</span></td>
                            <td>{{ row[4] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if tables.hot_leads|length > 5 %}
            <div class="lwa-table-footer">
                <button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaShowKpiDetail('hot_no_followup', 'Leads Quentes sem Follow-up')">
                    Ver todos ({{ tables.hot_leads|length }})
                </button>
            </div>
            {% endif %}
        {% endif %}
    </div>
</div>

{# ===== LEADS INCOMPLETOS ===== #}
{% if kpis.leads_incompletos > 0 %}
<div class="lwa-section-label">
    <span>Fila de Enriquecimento</span>
    <span class="lwa-section-badge">{{ kpis.leads_incompletos }}</span>
</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body" style="padding:14px 18px">
        <div style="display:flex;align-items:center;justify-content:space-between">
            <span style="font-size:14px;color:var(--lwa-gray-600)">{{ kpis.leads_incompletos }} leads sem e-mail ou telefone aguardando revisão</span>
            <button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaShowKpiDetail('leads_incompletos', 'Leads Incompletos')">
                Ver leads
            </button>
        </div>
    </div>
</div>
{% endif %}

{# ===== MODAIS ===== #}
<div id="lwa-kpi-detail" class="lwa-modal" style="display:none;">
    <div class="lwa-modal-overlay" onclick="Mautic.lwaCloseKpiDetail()"></div>
    <div class="lwa-modal-content lwa-modal-content--wide">
        <div class="lwa-modal-header">
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseKpiDetail()"><i class="ri-arrow-left-line"></i></button>
            <h3 id="lwa-kpi-detail-title"></h3>
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseKpiDetail()"><i class="ri-close-line"></i></button>
        </div>
        <div id="lwa-kpi-detail-body" class="lwa-modal-body"></div>
        <div id="lwa-kpi-pagination" class="lwa-pagination"></div>
    </div>
</div>

<div id="lwa-lead-modal" class="lwa-modal" style="display:none;">
    <div class="lwa-modal-overlay" onclick="Mautic.lwaCloseModal()"></div>
    <div class="lwa-modal-content">
        <div class="lwa-modal-header">
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseModal()"><i class="ri-arrow-left-line"></i></button>
            <h3 id="lwa-modal-title">Detalhes do Lead</h3>
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseModal()"><i class="ri-close-line"></i></button>
        </div>
        <div id="lwa-modal-body" class="lwa-modal-body"></div>
    </div>
</div>
