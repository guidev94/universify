{# Pipeline KPIs - Clicáveis #}
<div class="lwa-section-label">Pipeline Comercial</div>
<div class="lwa-kpi-row">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Prospecção Ativa',
        value: kpis.prospeccao,
        icon: 'ri-user-search-line',
        color: 'info',
        kpi_id: 'prospeccao',
        description: 'Leads em fase inicial'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Engajados',
        value: kpis.engajados,
        icon: 'ri-chat-check-line',
        color: 'warning',
        kpi_id: 'engajados',
        description: 'Responderam ou interagiram'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Reuniões',
        value: kpis.reunioes,
        icon: 'ri-calendar-check-line',
        color: 'primary',
        kpi_id: 'reunioes',
        description: 'Agendadas ou realizadas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Propostas Enviadas',
        value: kpis.propostas,
        icon: 'ri-file-text-line',
        color: 'purple',
        kpi_id: 'propostas',
        description: 'Em negociação'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Clientes Ganhos',
        value: kpis.ganhos,
        icon: 'ri-trophy-line',
        color: 'success',
        kpi_id: 'ganhos',
        description: 'Convertidos no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Sem Follow-up',
        value: kpis.hot_no_followup,
        icon: 'ri-alarm-warning-line',
        color: 'error',
        kpi_id: 'hot_no_followup',
        description: 'Quentes aguardando ação'
    } %}
</div>

{# E-mail Marketing KPIs #}
<div class="lwa-section-label">E-mail Marketing</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Enviados', value: kpis.emails_enviados, icon: 'ri-mail-send-line', color: 'primary',
        description: 'Total de e-mails disparados'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Abertos', value: kpis.emails_abertos, icon: 'ri-mail-open-line', color: 'success',
        description: 'Leads que abriram'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Taxa Abertura', value: kpis.taxa_abertura, icon: 'ri-percent-line', color: 'warning', suffix: '%',
        description: 'Performance de engajamento'
    } %}
</div>

{# Charts #}
<div class="lwa-section-label">Visão Geral</div>
<div class="lwa-charts-row">
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Distribuição por Temperatura',
        type: 'doughnut',
        data: charts.temperature,
        height: 300
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Novos Leads (últimos dias)',
        type: 'line',
        data: charts.leads_time,
        wide: true,
        height: 300
    } %}
</div>

{# Hot Leads — Card Grid #}
<div class="lwa-section-label">
    <span><i class="ri-fire-line"></i> Leads Quentes — Ação Necessária</span>
    <span class="lwa-section-badge">{{ kpis.hot_no_followup }} pendentes</span>
</div>

{% if tables.hot_leads is empty %}
    <div class="lwa-card"><div class="lwa-card-body"><div class="lwa-empty-state">
        <i class="ri-checkbox-circle-line"></i>
        <p>Todos os leads quentes estão com follow-up em dia!</p>
    </div></div></div>
{% else %}
    <div class="lwa-hot-grid">
        {% for row in tables.hot_leads %}
            <div class="lwa-kd-card" onclick="Mautic.lwaOpenLeadModal({{ row[6] }})">
                <div class="lwa-kd-card-top">
                    <div class="lwa-kd-avatar" style="background:{% if 'prioritario' in row[2] %}#9333ea{% else %}#dc2626{% endif %}">{{ row[0]|first|upper }}</div>
                    <div class="lwa-kd-info">
                        <div class="lwa-kd-name">{{ row[0] }}</div>
                        <div class="lwa-kd-role">{{ row[1] }}</div>
                    </div>
                    {{ row[2]|raw }}
                </div>
                <div class="lwa-kd-card-bottom">
                    <span class="lwa-kd-tag"><i class="ri-bar-chart-fill"></i> Score: {{ row[3] }}</span>
                    <span class="lwa-kd-tag"><i class="ri-time-line"></i> {{ row[4] }}</span>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

{# KPI Detail Modal (full width) #}
<div id="lwa-kpi-detail" class="lwa-modal" style="display:none;">
    <div class="lwa-modal-overlay" onclick="Mautic.lwaCloseKpiDetail()"></div>
    <div class="lwa-modal-content lwa-modal-content--wide">
        <div class="lwa-modal-header">
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseKpiDetail()" title="Fechar"><i class="ri-arrow-left-line"></i></button>
            <h3 id="lwa-kpi-detail-title"></h3>
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseKpiDetail()"><i class="ri-close-line"></i></button>
        </div>
        <div id="lwa-kpi-detail-body" class="lwa-modal-body"></div>
        <div id="lwa-kpi-pagination" class="lwa-pagination"></div>
    </div>
</div>

{# Lead Actions Modal #}
<div id="lwa-lead-modal" class="lwa-modal" style="display:none;">
    <div class="lwa-modal-overlay" onclick="Mautic.lwaCloseModal()"></div>
    <div class="lwa-modal-content">
        <div class="lwa-modal-header">
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseModal()" title="Voltar"><i class="ri-arrow-left-line"></i></button>
            <h3 id="lwa-modal-title">Ações do Lead</h3>
            <button class="lwa-action-btn" onclick="Mautic.lwaCloseModal()"><i class="ri-close-line"></i></button>
        </div>
        <div id="lwa-modal-body" class="lwa-modal-body"></div>
    </div>
</div>
