{# ===== PIPELINE COMERCIAL ===== #}
<div class="lwa-section-label">Pipeline Comercial</div>
<div class="lwa-kpi-row lwa-kpi-row--full">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Prospecção', value: kpis.prospeccao, icon: 'ri-user-search-line', color: 'info',
        kpi_id: 'prospeccao', description: 'Sem interação'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Frio', value: temperatura_counts.frio|default(0), icon: 'ri-temp-cold-line', color: 'info',
        kpi_id: 'temp_frio', description: 'Score 0–20'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Morno', value: temperatura_counts.morno|default(0), icon: 'ri-temp-hot-line', color: 'warning',
        kpi_id: 'temp_morno', description: 'Score 21–60'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Quente', value: temperatura_counts.quente|default(0), icon: 'ri-fire-line', color: 'error',
        kpi_id: 'temp_quente', description: 'Score 61–100'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Reuniões', value: kpis.reunioes_agendadas + kpis.reunioes_realizadas + kpis.reunioes_fechamento, icon: 'ri-calendar-check-line', color: 'primary',
        kpi_id: 'reunioes', description: 'Agendadas + realizadas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Propostas', value: kpis.propostas, icon: 'ri-file-text-line', color: 'purple',
        kpi_id: 'propostas', description: 'Em negociação'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Ganhos', value: kpis.ganhos, icon: 'ri-trophy-line', color: 'success',
        kpi_id: 'ganhos', description: 'Convertidos'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Sem Follow-up', value: kpis.hot_no_followup, icon: 'ri-alarm-warning-line', color: 'error',
        kpi_id: 'hot_no_followup', description: 'Quentes sem ação'
    } %}
</div>

{# ===== TEMPERATURA ===== #}
<div class="lwa-section-label">Temperatura dos Leads</div>
<div class="lwa-grid-2">
    <div class="lwa-card">
        <div class="lwa-card-body">
            <table class="lwa-table lwa-table--temp">
                <thead><tr><th>Score</th><th>Temperatura</th><th>Leads Ativos</th><th>Ação</th></tr></thead>
                <tbody>
                    {% for temp_key, temp_count in temperatura_counts %}
                        {% set score_range = {'frio':'0 – 20','morno':'21 – 60','quente':'61 – 100','prioritario':'100+'} %}
                        {% set actions = {'frio':'Iniciar primeiro contato','morno':'Conteúdo + abordagem consultiva','quente':'Comercial deve agir','prioritario':'Follow-up imediato'} %}
                        <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('temp_{{ temp_key }}', 'Leads {{ temp_key|capitalize }}')">
                            <td>{{ score_range[temp_key]|default('—') }}</td>
                            <td><span class="lwa-badge lwa-badge--{{ temp_key }}">{{ temp_key|capitalize }}</span></td>
                            <td><strong>{{ temp_count }}</strong></td>
                            <td>{{ actions[temp_key]|default('') }}</td>
                        </tr>
                    {% endfor %}
                    {% if kpis.leads_incompletos > 0 %}
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('leads_incompletos', 'Leads Incompletos')" style="border-top:2px solid var(--lwa-gray-100)">
                        <td>—</td><td><span class="lwa-tag">Incompleto</span></td><td><strong>{{ kpis.leads_incompletos }}</strong></td><td>Enriquecer dados (sem e-mail ou telefone)</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-body">
            <canvas class="lwa-chart" data-chart-type="doughnut" data-chart-data="{{ charts.temperature|json_encode }}" style="height:220px;width:100%;"></canvas>
        </div>
    </div>
</div>

{# ===== E-MAIL MARKETING ===== #}
<div class="lwa-section-label">
    <span>E-mail Marketing</span>
    <button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaAiTab('email')" style="font-size:11px;padding:4px 10px"><i class="ri-sparkling-line"></i> Sugerir Campanha</button>
</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Campanhas', value: kpis.campanhas, icon: 'ri-mail-send-line',
        kpi_id: 'emails_enviados', description: 'Campanhas ativas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'E-mails', value: kpis.disparos, icon: 'ri-send-plane-line',
        kpi_id: 'emails_abertos', description: 'Enviados nas campanhas'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Taxa de Abertura', value: kpis.taxa_abertura, icon: 'ri-percent-line',
        suffix: '%', kpi_id: 'emails_taxa', description: 'Desempenho geral'
    } %}
</div>

<div id="lwa-ai-tab-result" style="display:none;margin-bottom:24px"></div>

{# ===== ENGAJAMENTO ===== #}
{% if engagement is defined %}
<div class="lwa-section-label">Engajamento & Qualidade</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Formulários', value: engagement.form_fills, icon: 'ri-file-edit-line', color: 'success',
        kpi_id: 'engaj_forms', description: 'Preenchidos no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Downloads', value: engagement.downloads, icon: 'ri-download-2-line', color: 'info',
        kpi_id: 'engaj_downloads', description: 'Materiais baixados'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Em Campanhas', value: engagement.in_campaigns, icon: 'ri-megaphone-line',
        kpi_id: 'engaj_campanhas', description: 'Leads ativos em campanhas'
    } %}
    {% if engagement.duplicates > 0 %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Duplicados', value: engagement.duplicates, icon: 'ri-file-copy-line', color: 'warning', description: 'E-mails duplicados'
    } %}
    {% endif %}
</div>
{% endif %}

{# ===== LEADS INCOMPLETOS ===== #}
{% if kpis.leads_incompletos > 0 %}
<div class="lwa-section-label">
    <span>Fila de Enriquecimento</span>
    <button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaShowIncompleteQueue()" style="font-size:11px;padding:4px 10px"><i class="ri-user-add-line"></i> Gerenciar</button>
</div>
<div class="lwa-kpi-row lwa-kpi-row--compact" style="margin-bottom:24px">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Leads Incompletos', value: kpis.leads_incompletos, icon: 'ri-user-unfollow-line', color: 'warning',
        kpi_id: 'leads_incompletos', description: 'Sem e-mail ou telefone — aguardando enriquecimento'
    } %}
</div>
{% endif %}

{# ===== COMPORTAMENTO NO SITE ===== #}
{% if page_hits.total > 0 %}
<div class="lwa-section-label">
    <span>Comportamento no Site</span>
    <button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaAiTab('site')" style="font-size:11px;padding:4px 10px"><i class="ri-sparkling-line"></i> Analisar</button>
</div>
<div class="lwa-grid-2">
    <div class="lwa-card">
        <div class="lwa-card-body">
            <div class="lwa-kpi-row" style="margin:0">
                {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
                    title: 'Visitas', value: page_hits.total, icon: 'ri-eye-line',
                    kpi_id: 'site_visitas', description: 'Page views no período'
                } %}
                {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
                    title: 'Visitantes', value: page_hits.visitors, icon: 'ri-user-line',
                    kpi_id: 'site_visitantes', description: 'Leads identificados'
                } %}
                {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
                    title: 'Viram Preços', value: page_hits.pricing_visits, icon: 'ri-price-tag-3-line', color: 'success',
                    kpi_id: 'site_precos', description: 'Visitaram página de planos'
                } %}
            </div>
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Páginas Mais Visitadas</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            <table class="lwa-table lwa-table--compact">
                <tbody>
                    {% for p in page_hits.top_pages %}
                        <tr><td>{{ p.url_title }}</td><td><strong>{{ p.views }}</strong></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endif %}

{# ===== LEADS QUENTES ===== #}
<div class="lwa-section-label">
    <span>Leads Quentes — Ação Necessária</span>
    {% if kpis.hot_no_followup > 0 %}<span class="lwa-section-badge">{{ kpis.hot_no_followup }}</span>{% endif %}
</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body lwa-card-body--tight">
        {% if tables.hot_leads is empty %}
            <div class="lwa-empty-state"><i class="ri-checkbox-circle-line"></i><p>Nenhum lead quente sem follow-up.</p></div>
        {% else %}
            <table class="lwa-table">
                <thead><tr><th>Lead</th><th>Cargo</th><th>Temperatura</th><th>Score</th><th>Última Interação</th></tr></thead>
                <tbody>
                    {% for row in tables.hot_leads %}
                        <tr class="lwa-table-row-interactive" onclick="Mautic.lwaOpenLeadModal({{ row[6] }})">
                            <td><div class="lwa-lead-cell"><div class="lwa-lead-avatar lwa-lead-avatar--{% if 'prioritario' in row[2] %}prioritario{% else %}quente{% endif %}">{{ row[0]|first|upper }}</div><span class="lwa-lead-name">{{ row[0] }}</span></div></td>
                            <td>{{ row[1] }}</td><td>{{ row[2]|raw }}</td><td><span class="lwa-score-pill">{{ row[3] }}</span></td><td>{{ row[4] }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

{# ===== INSIGHTS IA ===== #}
<div class="lwa-section-label">
    <span><i class="ri-sparkling-line"></i> Insights IA</span>
    <button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaLoadInsights()" style="font-size:11px;padding:4px 10px">Gerar Análise</button>
</div>
<div id="lwa-insights" class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body" style="text-align:center;padding:20px;color:var(--lwa-gray-400);font-size:13px">
        Clique em "Gerar Análise" para a IA analisar suas métricas e sugerir ações.
    </div>
</div>

{# ===== INTELIGÊNCIA COMERCIAL ===== #}
{% if top_dores is not empty or top_modulos is not empty %}
<div class="lwa-section-label">Inteligência Comercial</div>
<div class="lwa-grid-2">
    {% if top_dores is not empty %}
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Principais Dores</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            <table class="lwa-table lwa-table--compact"><tbody>
                {% for d in top_dores %}<tr><td>{{ d.dor_principal }}</td><td><strong>{{ d.total }}</strong></td></tr>{% endfor %}
            </tbody></table>
        </div>
    </div>
    {% endif %}
    {% if top_modulos is not empty %}
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Módulos Mais Procurados</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            <table class="lwa-table lwa-table--compact"><tbody>
                {% for m in top_modulos %}
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowModuloLeads('{{ m.modulo_interesse|e('js') }}')">
                        <td>{{ m.modulo_interesse }}</td><td><strong>{{ m.total }}</strong></td>
                    </tr>
                {% endfor %}
            </tbody></table>
        </div>
    </div>
    {% endif %}
</div>
{% endif %}


{# ===== EVOLUÇÃO ===== #}
<div class="lwa-section-label">Entrada de Leads</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="line" data-chart-data="{{ charts.leads_time|json_encode }}" style="height:180px;width:100%;"></canvas>
    </div>
</div>

{# ===== FUNIL DE VENDAS ===== #}
<div class="lwa-section-label">
    <span>Funil de Vendas</span>
    <button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaAiTab('conversao','lwa-ai-tab-result-funnel')" style="font-size:11px;padding:4px 10px"><i class="ri-sparkling-line"></i> Melhorar Conversão</button>
</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ funnel|json_encode }}" style="height:260px;width:100%;"></canvas>
    </div>
</div>
<div id="lwa-ai-tab-result-funnel" style="display:none;margin-bottom:24px"></div>

{# Modais movidos para index.html.twig (globais) #}
