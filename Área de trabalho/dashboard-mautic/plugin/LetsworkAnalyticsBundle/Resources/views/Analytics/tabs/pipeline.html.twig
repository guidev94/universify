{# Velocidade do Pipeline (PRD Seção 18) #}
<div class="lwa-section-label">Velocidade do Pipeline</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Tempo até Reunião', value: avg_to_meeting, icon: 'ri-time-line', suffix: 'dias',
        description: 'Média entre entrada e primeira reunião'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Tempo até Proposta', value: avg_to_proposal, icon: 'ri-file-text-line', suffix: 'dias',
        description: 'Média entre entrada e envio de proposta'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Valor em Negociação', value: valor_pipeline|number_format(0, ',', '.'), icon: 'ri-money-dollar-circle-line', suffix: 'R$',
        description: 'Soma das oportunidades ativas'
    } %}
</div>

{# Distribuição por Temperatura + Módulos de Interesse (PRD Seção 6) #}
<div class="lwa-section-label">Distribuição</div>
<div class="lwa-grid-2">
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Por Temperatura</h4></div>
        <div class="lwa-card-body">
            <canvas class="lwa-chart" data-chart-type="doughnut" data-chart-data="{{ temperature|json_encode }}" style="height:260px;width:100%;"></canvas>
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Por Módulo de Interesse</h4></div>
        <div class="lwa-card-body">
            <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ by_module|json_encode }}" style="height:260px;width:100%;"></canvas>
        </div>
    </div>
</div>

{# Score ao Longo do Tempo #}
<div class="lwa-section-label">Evolução do Score Médio</div>
<div class="lwa-card">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="line" data-chart-data="{{ score_progress|json_encode }}" style="height:200px;width:100%;"></canvas>
    </div>
</div>

{# Etapas do Pipeline (PRD Seção 9) #}
<div class="lwa-section-label">Etapas do Pipeline Comercial</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body lwa-card-body--tight">
        {% if by_status is empty %}
            <div class="lwa-empty-state"><p>Sem dados no período.</p></div>
        {% else %}
            {% set status_labels = {
                'prospeccao': 'Prospecção',
                'engajado': 'Engajado',
                'reuniao_agendada': 'Reunião Agendada',
                'reuniao_realizada': 'Reunião Realizada',
                'proposta_enviada': 'Proposta Enviada',
                'negociacao': 'Negociação',
                'ganho': 'Cliente Ganho',
                'perdido': 'Perdido'
            } %}
            <table class="lwa-table">
                <thead><tr><th>Etapa</th><th>Leads</th><th>Valor Potencial</th></tr></thead>
                <tbody>
                    {% for r in by_status %}
                        <tr>
                            <td>{{ status_labels[r.status_comercial]|default(r.status_comercial|replace({'_': ' '})|title) }}</td>
                            <td><strong>{{ r.total }}</strong></td>
                            <td>R$ {{ r.valor|number_format(0, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
