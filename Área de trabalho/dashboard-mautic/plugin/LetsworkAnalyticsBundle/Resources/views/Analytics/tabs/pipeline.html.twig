{# Pipeline KPIs #}
<div class="lwa-section-label">Métricas do Pipeline</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Tempo até Reunião',
        value: avg_to_meeting,
        icon: 'ri-time-line',
        color: 'primary',
        suffix: 'dias',
        description: 'Média lead → 1ª reunião'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Tempo até Proposta',
        value: avg_to_proposal,
        icon: 'ri-file-text-line',
        color: 'success',
        suffix: 'dias',
        description: 'Média lead → proposta enviada'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card.html.twig' with {
        title: 'Valor no Pipeline',
        value: valor_pipeline|number_format(0, ',', '.'),
        icon: 'ri-money-dollar-circle-line',
        color: 'purple',
        suffix: 'R$',
        description: 'Oportunidades ativas'
    } %}
</div>

{# Charts #}
<div class="lwa-section-label">Distribuição e Progressão</div>
<div class="lwa-charts-row">
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Distribuição por Temperatura',
        type: 'doughnut',
        data: temperature,
        height: 300
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Interesse por Módulo LetsWork',
        type: 'bar',
        data: by_module,
        wide: true,
        height: 300
    } %}
</div>

{# Score Progression #}
<div class="lwa-section-label">Score Médio ao Longo do Tempo</div>
<div class="lwa-charts-row">
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Progressão de Score',
        type: 'line',
        data: score_progress,
        wide: true,
        height: 260
    } %}
</div>

{# Status Pipeline Table #}
<div class="lwa-section-label">Detalhamento por Etapa</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body">
        {% if by_status is empty %}
            <div class="lwa-empty-state"><i class="ri-flow-chart"></i><p>Sem dados de pipeline</p></div>
        {% else %}
            <table class="lwa-table">
                <thead>
                    <tr>
                        <th>Etapa</th>
                        <th>Leads</th>
                        <th>Valor Potencial</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in by_status %}
                        <tr>
                            <td><span class="lwa-tag">{{ r.status_comercial|replace({'_': ' '}) }}</span></td>
                            <td><strong>{{ r.total }}</strong></td>
                            <td>R$ {{ r.valor|number_format(0, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
