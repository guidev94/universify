{# KPIs Velocidade #}
<div class="lwa-section-label">Velocidade do Pipeline</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card_v2.html.twig' with {
        title: 'Tempo até Reunião', value: avg_to_meeting, icon: 'ri-time-line', color: 'primary',
        kpi_id: 'tempo_reuniao', suffix: 'dias', description: 'Da entrada até primeira reunião'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card_v2.html.twig' with {
        title: 'Tempo até Proposta', value: avg_to_proposal, icon: 'ri-file-text-line', color: 'purple',
        kpi_id: 'tempo_proposta', suffix: 'dias', description: 'Da entrada até proposta enviada'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card_v2.html.twig' with {
        title: 'Valor em Negociação', value: valor_pipeline|number_format(0, ',', '.'), icon: 'ri-money-dollar-circle-line', color: 'success',
        kpi_id: 'valor_negociacao', suffix: 'R$', description: 'Oportunidades ativas'
    } %}
</div>

{# Etapas do Pipeline — Dinâmico via banco #}
<div class="lwa-section-label">Etapas do Pipeline Comercial</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body lwa-card-body--tight">
        {% if by_status is empty %}
            <div class="lwa-empty-state"><p>Sem dados.</p></div>
        {% else %}
            {% set max_total = by_status[0].total|default(1) %}
            <table class="lwa-table">
                <thead><tr><th>Etapa</th><th>Leads</th><th>Valor Potencial</th><th></th></tr></thead>
                <tbody>
                    {% for r in by_status %}
                        {% set pct = max_total > 0 ? (r.total / max_total * 100)|round : 0 %}
                        <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('{{ r.status_comercial }}', '{{ r.status_comercial|replace({'_':' '})|title }}')">
                            <td><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--lwa-primary);margin-right:8px"></span>{{ r.status_comercial|replace({'_':' '})|title }}</td>
                            <td><strong>{{ r.total }}</strong></td>
                            <td>R$ {{ r.valor|number_format(0, ',', '.') }}</td>
                            <td style="width:30%"><div style="background:var(--lwa-gray-100);border-radius:4px;height:6px;overflow:hidden"><div style="background:var(--lwa-primary);height:100%;width:{{ pct }}%;border-radius:4px;opacity:{{ 0.4 + (pct / 100 * 0.6) }}"></div></div></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

{# Módulos de Interesse #}
<div class="lwa-section-label">Interesse por Módulo LetsWork</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ by_module|json_encode }}" style="height:220px;width:100%;"></canvas>
    </div>
</div>

{# Score #}
{% if score_progress.labels is not empty %}
<div class="lwa-section-label">Evolução do Score Médio</div>
<div class="lwa-card">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="line" data-chart-data="{{ score_progress|json_encode }}" style="height:180px;width:100%;"></canvas>
    </div>
</div>
{% endif %}

{# ===== IA ===== #}
<div class="lwa-section-label"><span><i class="ri-sparkling-line"></i> Análise IA — Pipeline</span><button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaAiTab('pipeline')" style="font-size:11px;padding:4px 10px">Analisar</button></div>
<div id="lwa-ai-tab-result" style="display:none;margin-bottom:24px"></div>
