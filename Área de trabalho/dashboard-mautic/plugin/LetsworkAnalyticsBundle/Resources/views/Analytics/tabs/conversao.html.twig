{# Funil de Conversão #}
<div class="lwa-section-label">Funil de Conversão</div>
<div class="lwa-charts-row">
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Lead → Engajado → Reunião → Proposta → Ganho',
        type: 'bar',
        data: funnel,
        wide: true,
        height: 320
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/chart_card.html.twig' with {
        title: 'Taxa de Ganho por Origem (%)',
        type: 'bar',
        data: win_rate,
        height: 320
    } %}
</div>

{# Tabela de Conversão por Origem #}
<div class="lwa-section-label">Conversão Detalhada por Origem</div>
<div class="lwa-table-section lwa-card">
    <div class="lwa-card-body">
        {% if by_origin is empty %}
            <div class="lwa-empty-state"><i class="ri-exchange-funds-line"></i><p>Sem dados de conversão no período</p></div>
        {% else %}
            <table class="lwa-table">
                <thead>
                    <tr>
                        <th>Origem</th>
                        <th>Total de Leads</th>
                        <th>Clientes Ganhos</th>
                        <th>Taxa de Conversão</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in by_origin %}
                        <tr>
                            <td><span class="lwa-tag">{{ r.origem_principal|replace({'_': ' '})|capitalize }}</span></td>
                            <td><strong>{{ r.total }}</strong></td>
                            <td>{{ r.ganhos }}</td>
                            <td><strong>{{ r.total > 0 ? ((r.ganhos / r.total * 100)|round(1)) : 0 }}%</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
