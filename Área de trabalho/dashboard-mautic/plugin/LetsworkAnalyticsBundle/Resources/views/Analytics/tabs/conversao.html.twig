{# KPIs de Conversão #}
<div class="lwa-section-label">Resumo de Conversão</div>
<div class="lwa-kpi-row lwa-kpi-row--compact">
    {% set tl = total_leads|default(0) %}
    {% set tg = total_ganhos|default(0) %}
    {% set taxa_geral = tl > 0 ? ((tg / tl * 100)|round(1)) : 0 %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card_v2.html.twig' with {
        title: 'Total de Leads', value: tl, icon: 'ri-team-line', color: 'primary',
        kpi_id: 'conv_total_leads', description: 'Base no período'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card_v2.html.twig' with {
        title: 'Convertidos', value: tg, icon: 'ri-trophy-line', color: 'success',
        kpi_id: 'conv_ganhos', description: 'Clientes ganhos'
    } %}
    {% include '@LetsworkAnalytics/Analytics/partials/kpi_card_v2.html.twig' with {
        title: 'Taxa Geral', value: taxa_geral, icon: 'ri-percent-line', color: 'primary',
        kpi_id: 'taxa_geral', suffix: '%', description: 'Lead → Cliente'
    } %}
</div>

{# Funil #}
<div class="lwa-section-label">Funil Completo {% if funnel.stage_ids is defined %}(Stages Mautic){% endif %}</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ funnel|json_encode }}" style="height:280px;width:100%;"></canvas>
    </div>
    {% if funnel.labels is not empty %}
    <div class="lwa-card-body lwa-card-body--tight" style="border-top:1px solid var(--lwa-gray-100)">
        <table class="lwa-table lwa-table--compact">
            <thead><tr><th>Etapa</th><th>Leads</th><th>Ação</th></tr></thead>
            <tbody>
                {% for i in 0..funnel.labels|length - 1 %}
                    {% set stage_kpi = funnel.stage_ids is defined ? 'conv_stage_' ~ funnel.stage_ids[i] : 'conv_total_leads' %}
                    <tr class="lwa-table-row-interactive" onclick="Mautic.lwaShowKpiDetail('{{ stage_kpi }}', '{{ funnel.labels[i] }}')">
                        <td><strong>{{ funnel.labels[i] }}</strong></td>
                        <td>{{ funnel.data[i] }}</td>
                        <td><i class="ri-arrow-right-s-line" style="color:var(--lwa-gray-400)"></i></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>

{# Win Rate + Tabela #}
<div class="lwa-section-label">Conversão por Origem</div>
<div class="lwa-grid-2">
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Taxa de Ganho (%)</h4></div>
        <div class="lwa-card-body">
            <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ win_rate|json_encode }}" style="height:220px;width:100%;"></canvas>
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Detalhamento</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_origin is empty %}
                <div class="lwa-empty-state"><p>Sem dados.</p></div>
            {% else %}
                <table class="lwa-table lwa-table--compact">
                    <thead><tr><th>Origem</th><th>Leads</th><th>Ganhos</th><th>Taxa</th></tr></thead>
                    <tbody>
                        {% for r in by_origin %}
                            <tr>
                                <td>{{ r.origem_principal|replace({'_':' '})|title }}</td>
                                <td>{{ r.total }}</td>
                                <td>{{ r.ganhos }}</td>
                                <td><strong>{{ r.total > 0 ? ((r.ganhos / r.total * 100)|round(1)) : 0 }}%</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>

{# ===== IA ===== #}
<div class="lwa-section-label"><span><i class="ri-sparkling-line"></i> Análise IA — Conversão</span><button class="lwa-btn lwa-btn--ghost" onclick="Mautic.lwaAiTab('conversao')" style="font-size:11px;padding:4px 10px">Analisar</button></div>
<div id="lwa-ai-tab-result" style="display:none;margin-bottom:24px"></div>
