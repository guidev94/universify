{# Funil de Conversão (PRD Seção 18) #}
<div class="lwa-section-label">Funil de Conversão</div>
<div class="lwa-card" style="margin-bottom:24px">
    <div class="lwa-card-header"><h4>Lead → Engajado → Reunião → Proposta → Ganho</h4></div>
    <div class="lwa-card-body">
        <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ funnel|json_encode }}" style="height:280px;width:100%;"></canvas>
    </div>
</div>

{# Taxa de Ganho por Origem (PRD Seção 18) #}
<div class="lwa-section-label">Taxa de Ganho por Origem</div>
<div class="lwa-grid-2">
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Win Rate (%)</h4></div>
        <div class="lwa-card-body">
            <canvas class="lwa-chart" data-chart-type="bar" data-chart-data="{{ win_rate|json_encode }}" style="height:240px;width:100%;"></canvas>
        </div>
    </div>
    <div class="lwa-card">
        <div class="lwa-card-header"><h4>Detalhamento por Origem</h4></div>
        <div class="lwa-card-body lwa-card-body--tight">
            {% if by_origin is empty %}
                <div class="lwa-empty-state"><p>Sem dados no período.</p></div>
            {% else %}
                {% set origin_labels = {
                    'linkedin_roboze': 'LinkedIn / Roboze',
                    'letswork_site': "Let's Work Site",
                    'apollo': 'Apollo',
                    'lista_importada': 'Lista Importada',
                    'indicação': 'Indicação'
                } %}
                <table class="lwa-table">
                    <thead><tr><th>Origem</th><th>Leads</th><th>Ganhos</th><th>Taxa</th></tr></thead>
                    <tbody>
                        {% for r in by_origin %}
                            <tr>
                                <td>{{ origin_labels[r.origem_principal]|default(r.origem_principal|replace({'_': ' '})|title) }}</td>
                                <td>{{ r.total }}</td>
                                <td>{{ r.ganhos }}</td>
                                <td><strong>{{ r.total > 0 ? ((r.ganhos / r.total * 100)|round(1)) : 0 }}%</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
