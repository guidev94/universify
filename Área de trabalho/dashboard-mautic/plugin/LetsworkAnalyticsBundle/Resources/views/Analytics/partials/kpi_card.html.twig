<div class="lwa-kpi-card lwa-card lwa-card--{{ color|default('primary') }}{% if kpi_id|default('') != '' %} lwa-kpi-clickable{% endif %}"
     {% if kpi_id|default('') != '' %}data-kpi-id="{{ kpi_id }}" onclick="Mautic.lwaShowKpiDetail('{{ kpi_id }}', '{{ title }}')"{% endif %}
     role="{% if kpi_id|default('') != '' %}button{% else %}status{% endif %}">
    <div class="lwa-kpi-icon">
        <i class="{{ icon }}"></i>
    </div>
    <div class="lwa-kpi-content">
        <span class="lwa-kpi-value" data-target="{{ value }}">{{ value }}</span>
        <span class="lwa-kpi-title">{{ title }}</span>
        {% if description|default('') != '' %}
            <span class="lwa-kpi-desc">{{ description }}</span>
        {% endif %}
    </div>
    {% if suffix|default('') != '' %}
        <span class="lwa-kpi-suffix">{{ suffix }}</span>
    {% endif %}
    {% if kpi_id|default('') != '' %}
        <i class="ri-arrow-right-s-line lwa-kpi-arrow"></i>
    {% endif %}
</div>
