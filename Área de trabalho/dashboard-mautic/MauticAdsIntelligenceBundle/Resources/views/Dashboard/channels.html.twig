{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}adsIntelligenceChannels{% endblock %}

{% block headerTitle %}{{ 'mautic.ads_intelligence.channels.title'|trans }}{% endblock %}

{% block content %}
<div class="ads-intelligence-channels">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">{{ 'mautic.ads_intelligence.channels.comparison'|trans }}</h3>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>{{ 'mautic.ads_intelligence.column.channel'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.investment'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.leads'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.hot_leads'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.opportunities'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.customers'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.revenue'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.cac'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.roas'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.lqs'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="10" class="text-center text-muted">
                                {{ 'mautic.ads_intelligence.overview.no_data'|trans }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
