{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}adsIntelligenceLogs{% endblock %}

{% block headerTitle %}{{ 'mautic.ads_intelligence.logs.title'|trans }}{% endblock %}

{% block content %}
<div class="ads-intelligence-logs">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">{{ 'mautic.ads_intelligence.logs.action_logs'|trans }}</h3>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ 'mautic.ads_intelligence.column.provider'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.event_type'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.message'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.user'|trans }}</th>
                            <th>{{ 'mautic.ads_intelligence.column.date'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                {{ 'mautic.ads_intelligence.overview.no_data'|trans }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
