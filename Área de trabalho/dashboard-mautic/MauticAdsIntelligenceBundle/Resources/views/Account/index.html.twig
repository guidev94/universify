{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}adsIntelligenceAccounts{% endblock %}

{% block headerTitle %}{{ 'mautic.ads_intelligence.accounts.title'|trans }}{% endblock %}

{% block content %}
<div class="ads-intelligence-accounts">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="clearfix">
                <h3 class="panel-title pull-left">{{ 'mautic.ads_intelligence.accounts.list'|trans }}</h3>
                <form method="post" action="{{ path('mautic_ads_intelligence_accounts_sync') }}" class="pull-right">
                    <input type="hidden" name="_token" value="{{ csrf_token('ads_intelligence_sync_accounts') }}">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="ri-refresh-line"></i> {{ 'mautic.ads_intelligence.accounts.sync'|trans }}
                    </button>
                </form>
            </div>
        </div>
        <div class="panel-body">
            <p class="text-muted small">
                {{ 'mautic.ads_intelligence.accounts.sync_enabled_providers_only'|trans }}
            </p>

            {% if accountsWithLimitedAccess > 0 %}
                <div class="alert alert-warning">
                    <strong>{{ 'mautic.ads_intelligence.accounts.limited_access_title'|trans }}</strong><br>
                    {{ 'mautic.ads_intelligence.accounts.limited_access_message'|trans({'%count%': accountsWithLimitedAccess}) }}
                </div>
            {% endif %}

            {% if accounts is empty %}
                <p class="text-muted text-center">{{ 'mautic.ads_intelligence.accounts.no_accounts'|trans }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>{{ 'mautic.ads_intelligence.column.provider'|trans }}</th>
                                <th>{{ 'mautic.ads_intelligence.column.name'|trans }}</th>
                                <th>{{ 'mautic.ads_intelligence.column.external_id'|trans }}</th>
                                <th>{{ 'mautic.ads_intelligence.column.currency'|trans }}</th>
                                <th>{{ 'mautic.ads_intelligence.column.status'|trans }}</th>
                                <th>{{ 'mautic.ads_intelligence.column.last_sync'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for account in accounts %}
                                <tr>
                                    <td>{{ account.provider }}</td>
                                    <td>{{ account.name }}</td>
                                    <td>{{ account.externalAccountId }}</td>
                                    <td>{{ account.currency }}</td>
                                    <td>{{ account.status }}</td>
                                    <td>{{ account.lastSyncAt ? account.lastSyncAt|date('d/m/Y H:i') : '—' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
